{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CTX-Audit",
          "version": "0.1.0",
          "informationUri": "https://github.com/ctx-audit/ctx-audit",
          "rules": [
            {
              "id": "CWE-89",
              "name": "SQL Injection",
              "short_description": {
                "text": "User input flows into SQL query without proper sanitization"
              },
              "full_description": {
                "text": "The software constructs all or part of an SQL command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended SQL command."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": {
                "category": "injection",
                "severity": "critical"
              }
            },
            {
              "id": "CWE-78",
              "name": "OS Command Injection",
              "short_description": {
                "text": "User input flows into OS command execution without proper sanitization"
              },
              "full_description": {
                "text": "The software constructs all or part of an OS command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended OS command."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "properties": {
                "category": "injection",
                "severity": "critical"
              }
            },
            {
              "id": "CWE-22",
              "name": "Path Traversal",
              "short_description": {
                "text": "User input is used to construct a file path without proper validation"
              },
              "full_description": {
                "text": "The software uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the software does not properly neutralize special elements within the pathname."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "properties": {
                "category": "path-manipulation",
                "severity": "high"
              }
            },
            {
              "id": "CWE-79",
              "name": "Cross-Site Scripting (XSS)",
              "short_description": {
                "text": "User input is rendered in HTML output without proper escaping"
              },
              "full_description": {
                "text": "The software does not neutralize or incorrectly neutralizes user-controllable input before it is placed in output that is used as a web page that is served to other users."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "properties": {
                "category": "xss",
                "severity": "high"
              }
            },
            {
              "id": "CWE-918",
              "name": "Server-Side Request Forgery (SSRF)",
              "short_description": {
                "text": "User input controls the target of an outgoing HTTP request"
              },
              "full_description": {
                "text": "The software constructs HTTP requests from user-supplied input without proper validation, allowing the attacker to make the server send requests to unintended destinations."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "properties": {
                "category": "ssrf",
                "severity": "high"
              }
            },
            {
              "id": "CWE-94",
              "name": "Code Injection",
              "short_description": {
                "text": "User input is passed to a code evaluation function without proper sanitization"
              },
              "full_description": {
                "text": "The software constructs all or part of a code segment using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the syntax or behavior of the intended code segment."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/94.html",
              "properties": {
                "severity": "critical",
                "category": "injection"
              }
            }
          ]
        }
      },
      "invocations": [
