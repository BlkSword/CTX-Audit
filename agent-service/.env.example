# CTX-Audit Agent Service 环境变量配置（精简版）

# ========== 服务配置 ==========
AGENT_PORT=8001
LOG_LEVEL=info

# ========== Rust 后端 ==========
RUST_BACKEND_URL=http://localhost:8000

# ========== SQLite 数据库 ==========
# 数据库文件路径（相对于应用根目录）
DATABASE_PATH=audit_agent.db

# ========== LLM 配置 ==========
# 支持: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ========== RAG 配置 ==========
# 禁用 RAG，使用云端 LLM 无需本地向量检索
RAG_ENABLED=false

# ========== Agent 配置 ==========
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT=300
ENABLE_VERIFICATION=false

# ========== 安全配置 ==========
# API 密钥（可选，为空则不启用）
API_KEY=
